{
  "permissionGrants": {
    "deny": [
      "read_file(.secrets)",
      "edit_file(.secrets)",
      "write_file(.secrets)",
      "command(regex:(?:^|[\\s\"'`\\\\/<>=;|&(])\\.secrets(?:$|[\\s\"'`\\\\/>;|&\\)]))",
      "command(docker)",
      "command(regex:docker .*)",
      "command(regex:(yarn|npm) --(cwd|prefix) \\S+ validate:docker)",
      "command(regex:(yarn|npm) --(cwd|prefix)=\\S+ validate:docker)",
      "command(regex:(yarn|npm) --(cwd|prefix) \\S+ run validate:docker)",
      "command(regex:(yarn|npm) --(cwd|prefix)=\\S+ run validate:docker)",
      "command(regex:(yarn|npm) validate:docker)",
      "command(regex:(yarn|npm) run validate:docker)",
      "command(regex:corepack (yarn|npm) --(cwd|prefix) \\S+ validate:docker)",
      "command(regex:corepack (yarn|npm) --(cwd|prefix)=\\S+ validate:docker)",
      "command(regex:corepack (yarn|npm) --(cwd|prefix) \\S+ run validate:docker)",
      "command(regex:corepack (yarn|npm) --(cwd|prefix)=\\S+ run validate:docker)",
      "command(regex:corepack (yarn|npm) validate:docker)",
      "command(regex:corepack (yarn|npm) run validate:docker)",
      "command(regex:npm (--prefix|-C) (ingress-events-core|iitc-plugin-site-observer) .*)",
      "command(regex:npm --prefix=(ingress-events-core|iitc-plugin-site-observer) .*)",
      "command(regex:corepack npm (--prefix|-C) (ingress-events-core|iitc-plugin-site-observer) .*)",
      "command(regex:corepack npm --prefix=(ingress-events-core|iitc-plugin-site-observer) .*)",
      "command(regex:yarn --cwd (ingress-shards\\.github\\.io|ingress-events-ai-kit) .*)",
      "command(regex:yarn --cwd=(ingress-shards\\.github\\.io|ingress-events-ai-kit) .*)",
      "command(regex:corepack yarn --cwd (ingress-shards\\.github\\.io|ingress-events-ai-kit) .*)",
      "command(regex:corepack yarn --cwd=(ingress-shards\\.github\\.io|ingress-events-ai-kit) .*)"
    ],
    "ask": [
      "command(regex:git (commit|push|pull|add|rm|mv|restore|checkout|switch|merge|rebase|reset|cherry-pick|revert|init|worktree|clean|am|apply|stash) .*)",
      "command(regex:git -C \\S+ (commit|push|pull|add|rm|mv|restore|checkout|switch|merge|rebase|reset|cherry-pick|revert|init|worktree|clean|am|apply|stash) .*)",
      "command(regex:git branch (-[A-Za-z]*[dDmMcCfl][A-Za-z]*|--delete|--move|--copy|--force|--set-upstream-to|--unset-upstream|--edit-description|--create-reflog) .*)",
      "command(regex:git -C \\S+ branch (-[A-Za-z]*[dDmMcCfl][A-Za-z]*|--delete|--move|--copy|--force|--set-upstream-to|--unset-upstream|--edit-description|--create-reflog) .*)",
      "command(regex:git tag (-[A-Za-z]*[dasfm][A-Za-z]*|--delete|--annotate|--sign|--force|--message) .*)",
      "command(regex:git -C \\S+ tag (-[A-Za-z]*[dasfm][A-Za-z]*|--delete|--annotate|--sign|--force|--message) .*)",
      "command(regex:git remote (add|remove|rm|rename|set-url|prune|update) .*)",
      "command(regex:git -C \\S+ remote (add|remove|rm|rename|set-url|prune|update) .*)",
      "command(regex:node .*sync\\.mjs .*)"
    ],
    "allow": [
      "command(regex:yarn --cwd [A-Za-z0-9][A-Za-z0-9._-]* (validate|validate:check|lint|test|test:unit))",
      "command(regex:corepack yarn --cwd [A-Za-z0-9][A-Za-z0-9._-]* (validate|validate:check|lint|test|test:unit))",
      "command(regex:yarn (validate|validate:check|lint|test|test:unit))",
      "command(regex:corepack yarn (validate|validate:check|lint|test|test:unit))",
      "command(regex:npm --prefix [A-Za-z0-9][A-Za-z0-9._-]* run (validate|validate:check|lint))",
      "command(regex:npm --prefix [A-Za-z0-9][A-Za-z0-9._-]* test)",
      "command(regex:npm run (validate|validate:check|lint))",
      "command(npm test)",
      "command(regex:node --test)",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* status -s)",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* branch --show-current)",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* tag --sort=-v:refname)",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* diff)",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* diff (--stat|--staged|[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?\\.\\.\\.HEAD))",
      "command(regex:git -C [A-Za-z0-9][A-Za-z0-9._-]* (log|show|grep) .*)",
      "command(git status -s)",
      "command(git branch --show-current)",
      "command(git tag --sort=-v:refname)",
      "command(git diff)",
      "command(regex:git diff (--stat|--staged|[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?\\.\\.\\.HEAD))",
      "command(regex:git (log|show|grep) .*)"
    ]
  }
}
